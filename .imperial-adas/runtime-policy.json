{
  "schemaVersion": "2.1",
  "status": "RECOVERY_RELEASE_STOP_LOCAL_VALIDATION_ONLY",
  "productionMode": false,
  "openTelemetry": {
    "enabled": false,
    "controlPlaneEnabled": true,
    "applicationInstrumentationRequired": true,
    "serviceName": "imperial-intelligence-platform-core",
    "signals": ["traces", "metrics", "logs"],
    "protocol": "http/protobuf",
    "endpoint": "environment:OTEL_EXPORTER_OTLP_ENDPOINT"
  },
  "healthChecks": [],
