  "requiredBusinessMetrics": [
    "outbox_pending_total",
    "outbox_failed_total",
    "canonical_sync_contention_total",
    "care_open_cases_total",
    "tender_active_invitations_total",
    "publishing_external_writes_total"
  ],
  "businessMetrics": [],
  "metricsJsonEndpoint": "",
  "metricsSnapshotPath": "",
  "reconciliation": {"enabled": false, "rules": []},
  "canary": {"enabled": false, "automaticStopOnBreach": true, "minimumHealthyMinutesPerStage": 10, "stages": [1, 5, 25, 100]},
  "automaticRollbackEnabled": false,
  "deployCommand": "",
  "rollbackCommand": "",
  "forwardRecoveryCommand": ""
}
