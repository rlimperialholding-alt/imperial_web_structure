APP_ENV=development
LOG_LEVEL=INFO
DATABASE_HOST=dpm-postgres
DATABASE_PORT=5432
DATABASE_NAME=imperial_dpm
DATABASE_USER=imperial_dpm
DATABASE_PASSWORD_FILE=/run/secrets/dpm_db_password
REDIS_URL=redis://dpm-redis:6379/0
QUEUE_ENABLED=true
PLATFORM_DATA_PATH=/data/platform.json

AUTH_MODE=oidc
AUTH_ISSUER=imperial-intelligence
AUTH_AUDIENCE=digital-project-managers
# Prefer AUTH_JWKS_URL for an existing OIDC provider.
AUTH_JWKS_URL=
# Local-only HS256 fallback reads this mounted secret file.
AUTH_HS256_SECRET_FILE=/run/secrets/dpm_auth_hs256_secret

EXTERNAL_WRITES_ENABLED=false
PARTNER_CONTROL_BASE_URL=
PARTNER_CONTROL_TOKEN_FILE=
TENDER_PORTAL_BASE_URL=
TENDER_PORTAL_TOKEN_FILE=
MYIMPERIAL_BASE_URL=
MYIMPERIAL_TOKEN_FILE=
EMAIL_SERVICE_BASE_URL=
EMAIL_SERVICE_TOKEN_FILE=
