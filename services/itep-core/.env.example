DATABASE_URL="postgresql://itep:change-me@localhost:5432/itep?schema=public"

DEFAULT_ORGANIZATION_ID="imperial-holding"
DEFAULT_ASSIGNEE_ID="human-anne"
DEFAULT_ESCALATION_PERSON_ID="director"
DEFAULT_CONTACT_EMAIL="office@example.invalid"
IDENTITY_SHARED_SECRET="replace-with-at-least-32-characters"
API_RATE_LIMIT_MAX="300"
API_RATE_LIMIT_WINDOW_MS="60000"
CONNECTOR_SYNC_INTERVAL_MS="60000"
CONNECTOR_ACCESS_TOKENS_JSON="{}"
INTEGRATION_RETRY_INTERVAL_MS="30000"
INTEGRATION_RETRY_BATCH_SIZE="50"
BILLINGO_API_BASE_URL="https://api.billingo.hu"
BANK_API_BASE_URL="https://your-psd2-provider.example"
CRM_API_BASE_URL="https://your-crm.example"

CRM_ACTIVITIES_PATH="/api/v1/activities"
CRM_AUTH_HEADER="Authorization"
CRM_AUTH_SCHEME="Bearer"
CRM_WORKSPACE_QUERY_PARAMETER="workspace"
CRM_WORKSPACE_ID="imperial"
CONNECTOR_ACCESS_TOKENS_JSON='{"crm-live":"replace-with-read-only-token"}'
