GOOGLE_OAUTH_TOKEN_URL="https://oauth2.googleapis.com/token"
BANK_API_BASE_URL="https://your-psd2-provider.example"
CRM_API_BASE_URL="https://your-crm.example"

CONNECTOR_ACCESS_TOKEN_BILLINGO_LIVE="replace-with-billingo-api-key"
BILLINGO_LEGAL_ENTITY_ID="imperial-holding:replace-with-company-slug"
BILLINGO_EXTERNAL_ACCOUNT_ID="all"
CONNECTOR_ACCESS_TOKEN_META_ADS_LIVE="replace-with-meta-access-token"
