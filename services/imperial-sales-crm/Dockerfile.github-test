FROM node:22-bookworm-slim

WORKDIR /app

ARG NPM_STRICT_SSL=true

ENV NODE_ENV=test
ENV npm_config_strict_ssl=${NPM_STRICT_SSL}

ENV SITES_SKIP_TARBALL_PREFLIGHT=1
ENV SITES_INSTALL_TIMEOUT=30m
ENV SITES_NPM_MAXSOCKETS=16
# A BuildKit cache remains mounted below, but npm must be allowed to refresh a
# partial cache. Forcing prefer-offline can trigger npm's "Exit handler never
# called" failure after an interrupted image build.
ENV SITES_PREFER_OFFLINE=0

COPY package.json package-lock.json .npmrc ./
COPY scripts ./scripts
RUN chmod +x ./scripts/*.sh
RUN --mount=type=cache,target=/app/.sites-runtime/npm-cache \
    --mount=type=secret,id=build_ca,required=false \
    if grep -q "BEGIN CERTIFICATE" /run/secrets/build_ca 2>/dev/null; then \
      export NODE_EXTRA_CA_CERTS=/run/secrets/build_ca; \
    fi; \
    npm install --global npm@11.16.0 --no-audit --no-fund \
    && npm run install:ci

COPY . .

RUN npm run typecheck

RUN npm prune --omit=dev \
    && npm cache clean --force \
    && rm -rf \
      /app/.sites-runtime/npm-cache \
      /app/node_modules/next/dist/compiled/react-server-dom-webpack \
      /usr/local/lib/node_modules/npm \
      /usr/local/bin/npm \
      /usr/local/bin/npx

RUN mkdir -p /app/.wrangler/state /app/.sites-runtime /app/node_modules/.vite /app/node_modules/.mf \
    && chown node:node /app \
    && chown -R node:node /app/.wrangler /app/.sites-runtime /app/node_modules/.vite /app/node_modules/.mf

USER node

EXPOSE 8787

CMD ["sh", "scripts/start-github-test.sh"]
