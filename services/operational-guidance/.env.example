# Monorepo-safe namespace. These values avoid collisions with the existing web staging stack.
COMPOSE_PROJECT_NAME=imperial-oge
IMPERIAL_HUB_IMAGE=imperial-operational-guidance:0.8.1
OGE_API_PORT=18080
OGE_DIRECTUS_PORT=18055
OGE_N8N_PORT=15678
OGE_MINIO_PORT=19000
OGE_MINIO_CONSOLE_PORT=19001

APP_ENV=development
APP_NAME=Imperial Intelligence Integration Hub
APP_VERSION=0.8.1

COMPOSE_PROJECT_NAME=imperial-guidance
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
DIRECTUS_IMAGE=directus/directus:REPLACE_PINNED_VERSION
N8N_IMAGE=n8nio/n8n:REPLACE_PINNED_VERSION
MINIO_IMAGE=minio/minio:REPLACE_PINNED_VERSION
MINIO_MC_IMAGE=minio/mc:REPLACE_PINNED_VERSION
API_PREFIX=/api/v1
API_ADMIN_TOKEN=change-this-long-random-token
HUMAN_ROLE_TOKENS_JSON={}
SERVICE_TOKENS_JSON={}
N8N_SERVICE_TOKEN=
REQUIRE_ROLE_TOKENS=false
REQUIRE_IDEMPOTENCY_KEYS=false
METRICS_ENABLED=true
METRICS_TOKEN=
AUDIT_LOG_ENABLED=true
TRUSTED_HOSTS_JSON=["*"]
CORS_ORIGINS_JSON=[]
DOCS_ENABLED=true
MAX_REQUEST_BODY_BYTES=2000000
DATABASE_URL=postgresql+psycopg://imperial:imperial@postgres:5432/imperial
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
AUTO_CREATE_DB_SCHEMA=true
STARTUP_VALIDATE_CONFIG=true
READINESS_CHECK_REDIS=true

# Feature switches. External publication is opt-in.
OPERATIONAL_GUIDANCE_ENABLED=true
DRIVE_PUBLICATION_ENABLED=false
GMAIL_APPROVAL_ENABLED=false

# Google service-account credentials used by GA4, Search Console and optional Process Card publication.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
GA4_PROPERTIES_JSON=[]
SEARCH_CONSOLE_SITES_JSON=[]

# Google Business Profile requires an approved Google Cloud project and user OAuth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GBP_LOCATIONS_JSON=[]

# ingatlan.com API account. Use apitest while validating field mappings.
INGATLAN_BASE_URL=https://apitest.ingatlan.com/v1
INGATLAN_USERNAME=
INGATLAN_PASSWORD=

# Directus Content Hub
DIRECTUS_URL=http://directus:8055
DIRECTUS_STATIC_TOKEN=
DIRECTUS_WEBHOOK_SECRET=change-directus-webhook-secret
DIRECTUS_CONTENT_COLLECTION=content_items
DIRECTUS_WEBSITE_COLLECTION=websites

# Multi-brand registry.
BRAND_REGISTRY_FILE=config/brand-registry.json
BRAND_REGISTRY_JSON={}

# Website publishing targets.
WEBSITE_TARGETS_FILE=config/website-targets.json
WEBSITE_TARGETS_JSON={}

# PostgreSQL / Directus / n8n / MinIO local defaults. Replace outside development.
POSTGRES_USER=imperial
POSTGRES_PASSWORD=imperial
POSTGRES_DB=imperial
DIRECTUS_ADMIN_EMAIL=admin@imperial.local
DIRECTUS_ADMIN_PASSWORD=change-this-password
DIRECTUS_KEY=replace-this-directus-key
DIRECTUS_SECRET=replace-this-directus-secret
N8N_ENCRYPTION_KEY=replace-this-n8n-encryption-key
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

# Operational Process Card + Checklist Engine
PROCESS_CARD_RUNTIME_ROOT=runtime/process_cards
PROCESS_CARD_PUBLISH_ROOT=runtime/published_process_cards
CHECKLIST_RUNTIME_ROOT=runtime/checklists
OPERATIONAL_CATALOG_FILE=config/operational-process-catalog-v1.0.json
PROCESS_CATALOG_COLLECTION=process_catalog
CHECKLIST_TEMPLATE_COLLECTION=checklist_templates
CHECKLIST_INSTANCE_COLLECTION=checklist_instances
PROCESS_CARD_COLLECTION=process_card_versions
PROCESS_CARD_DRIVE_FOLDER_ID=
PROCESS_CARD_APPROVER_EMAIL=
PROCESS_CARD_GMAIL_DELEGATED_USER=

# ITEP Core internal service integration
ITEP_ENABLED=true
ITEP_BASE_URL=http://itep-api:3000
ITEP_IDENTITY_SHARED_SECRET=change-me
ITEP_SERVICE_ACTOR_ID=integration-hub
ITEP_ORGANIZATION_ID=imperial-holding
ITEP_CRM_CONNECTOR_ID=crm-live
ITEP_TIMEOUT_SECONDS=15
