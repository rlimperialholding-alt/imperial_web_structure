{
  "name": "Imperial Operational Guidance – Process Card and Checklist",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "imperial-operational-source-changed",
        "responseMode": "responseNode"
      },
      "id": "source-webhook",
      "name": "Operational Source Changed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 180]
