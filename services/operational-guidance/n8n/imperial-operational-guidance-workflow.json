        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "X-Directus-Secret", "value": "={{$env.DIRECTUS_WEBHOOK_SECRET}}"}
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify($json.body)}}"
      },
      "id": "source-sync",
      "name": "Regenerate Changed Guidance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{JSON.stringify({accepted: true, result: $json})}}"
      },
      "id": "source-response",
      "name": "Source Change Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [780, 180]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "imperial-process-started",
        "responseMode": "responseNode"
      },
      "id": "process-webhook",
      "name": "Business Process Started",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 440]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.IMPERIAL_HUB_URL + '/api/v1/process-cards/' + $json.body.process_key + '/checklists/start'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "={{'Bearer ' + $env.IMPERIAL_HUB_SERVICE_TOKEN}}"}
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify({object_id: $json.body.object_id, object_type: $json.body.object_type, created_by: $json.body.created_by, metadata: $json.body.metadata || {}})}}"
      },
      "id": "start-checklist",
      "name": "Start Required Checklist",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 440]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{JSON.stringify({accepted: true, checklist: $json})}}"
      },
      "id": "process-response",
      "name": "Process Start Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [780, 440]
    },
    {
      "parameters": {
