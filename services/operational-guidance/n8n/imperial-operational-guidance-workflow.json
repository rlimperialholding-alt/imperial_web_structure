      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 700]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.IMPERIAL_HUB_URL + '/api/v1/checklists/instances/' + $json.body.instance_id + '/gate'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "={{'Bearer ' + $env.IMPERIAL_HUB_SERVICE_TOKEN}}"}
          ]
        }
      },
      "id": "read-gate",
      "name": "Read Gate Status",
      "type": "n8n-nodes-base.httpRequest",
