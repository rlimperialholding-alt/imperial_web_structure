      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [780, 300]
    }
  ],
  "connections": {
    "Approved Content Webhook": {
      "main": [[{"node": "Create Publication Job", "type": "main", "index": 0}]]
    },
    "Create Publication Job": {
      "main": [[{"node": "Respond", "type": "main", "index": 0}]]
    }
