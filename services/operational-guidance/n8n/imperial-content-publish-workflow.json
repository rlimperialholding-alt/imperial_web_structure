{
  "name": "Imperial Content Approval to Publish",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "imperial-content-approved",
        "responseMode": "responseNode"
      },
      "id": "webhook",
      "name": "Approved Content Webhook",
      "type": "n8n-nodes-base.webhook",
