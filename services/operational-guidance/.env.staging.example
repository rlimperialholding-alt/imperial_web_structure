APP_ENV=staging
APP_NAME=Imperial Intelligence Integration Hub
APP_VERSION=0.8.1

COMPOSE_PROJECT_NAME=imperial-guidance
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
DIRECTUS_IMAGE=directus/directus:REPLACE_PINNED_VERSION
N8N_IMAGE=n8nio/n8n:REPLACE_PINNED_VERSION
MINIO_IMAGE=minio/minio:REPLACE_PINNED_VERSION
MINIO_MC_IMAGE=minio/mc:REPLACE_PINNED_VERSION
API_PREFIX=/api/v1
API_ADMIN_TOKEN=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
HUMAN_ROLE_TOKENS_JSON={"Ügyvezető":"REPLACE_UGYVEZETO_32_PLUS_SECRET","Marketinges":"REPLACE_MARKETINGES_32_PLUS_SECRET","Értékesítő":"REPLACE_ERTEKESITO_32_PLUS_SECRET","Pénzügyes":"REPLACE_PENZUGYES_32_PLUS_SECRET","Projektmenedzser":"REPLACE_PROJEKTMENEDZSER_32_PLUS_SECRET"}
SERVICE_TOKENS_JSON={"n8n":"REPLACE_N8N_SERVICE_32_PLUS_SECRET","directus":"REPLACE_DIRECTUS_SERVICE_32_PLUS_SECRET"}
N8N_SERVICE_TOKEN=REPLACE_N8N_SERVICE_32_PLUS_SECRET
REQUIRE_ROLE_TOKENS=true
REQUIRE_IDEMPOTENCY_KEYS=true
METRICS_ENABLED=true
METRICS_TOKEN=REPLACE_METRICS_32_PLUS_SECRET
AUDIT_LOG_ENABLED=true
TRUSTED_HOSTS_JSON=["staging-api.example.com","localhost","127.0.0.1"]
CORS_ORIGINS_JSON=[]
DOCS_ENABLED=false
MAX_REQUEST_BODY_BYTES=2000000
DATABASE_URL=postgresql+psycopg://imperial_staging:REPLACE_DB_PASSWORD@postgres:5432/imperial
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
AUTO_CREATE_DB_SCHEMA=false
STARTUP_VALIDATE_CONFIG=true
READINESS_CHECK_REDIS=true

OPERATIONAL_GUIDANCE_ENABLED=true
DRIVE_PUBLICATION_ENABLED=true
GMAIL_APPROVAL_ENABLED=true

POSTGRES_USER=imperial_staging
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
POSTGRES_DB=imperial
DIRECTUS_ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
DIRECTUS_ADMIN_PASSWORD=REPLACE_STRONG_PASSWORD
DIRECTUS_KEY=REPLACE_32_PLUS_CHARACTER_KEY
DIRECTUS_SECRET=REPLACE_32_PLUS_CHARACTER_SECRET
DIRECTUS_URL=http://directus:8055
DIRECTUS_STATIC_TOKEN=REPLACE_DIRECTUS_STATIC_TOKEN
DIRECTUS_WEBHOOK_SECRET=REPLACE_WITH_32_PLUS_CHARACTER_RANDOM_SECRET
DIRECTUS_CONTENT_COLLECTION=content_items
DIRECTUS_WEBSITE_COLLECTION=websites
N8N_ENCRYPTION_KEY=REPLACE_32_PLUS_CHARACTER_KEY
MINIO_ROOT_USER=imperial_minio
MINIO_ROOT_PASSWORD=REPLACE_STRONG_PASSWORD

GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
PROCESS_CARD_DRIVE_FOLDER_ID=REPLACE_DRIVE_FOLDER_ID
PROCESS_CARD_APPROVER_EMAIL=REPLACE_APPROVER_EMAIL
PROCESS_CARD_GMAIL_DELEGATED_USER=REPLACE_DELEGATED_SENDER_EMAIL

PROCESS_CARD_RUNTIME_ROOT=runtime/process_cards
PROCESS_CARD_PUBLISH_ROOT=runtime/published_process_cards
CHECKLIST_RUNTIME_ROOT=runtime/checklists
OPERATIONAL_CATALOG_FILE=config/operational-process-catalog-v1.0.json
PROCESS_CATALOG_COLLECTION=process_catalog
CHECKLIST_TEMPLATE_COLLECTION=checklist_templates
CHECKLIST_INSTANCE_COLLECTION=checklist_instances
PROCESS_CARD_COLLECTION=process_card_versions

GA4_PROPERTIES_JSON=[]
SEARCH_CONSOLE_SITES_JSON=[]
GBP_LOCATIONS_JSON=[]
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
INGATLAN_BASE_URL=https://apitest.ingatlan.com/v1
INGATLAN_USERNAME=
INGATLAN_PASSWORD=
BRAND_REGISTRY_FILE=config/brand-registry.json
BRAND_REGISTRY_JSON={}
WEBSITE_TARGETS_FILE=config/website-targets.json
WEBSITE_TARGETS_JSON={}
