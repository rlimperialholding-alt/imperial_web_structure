FROM python:3.12-slim AS base
ARG PIP_TRUSTED_HOST
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="Imperial ETDR-OENY Authority Reader" \
      org.opencontainers.image.revision="${VCS_REF}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
RUN addgroup --system --gid 10001 imperial \
    && adduser --system --uid 10001 --ingroup imperial imperial
COPY requirements.etdr.txt .
RUN --mount=type=secret,id=build_ca,required=false \
    if grep -q "BEGIN CERTIFICATE" /run/secrets/build_ca 2>/dev/null; then \
      cat /etc/ssl/certs/ca-certificates.crt /run/secrets/build_ca > /tmp/build-ca.pem; \
      export PIP_CERT=/tmp/build-ca.pem; \
    fi; \
    PIP_TRUSTED_HOST="${PIP_TRUSTED_HOST}" pip install --no-cache-dir -r requirements.etdr.txt; \
    status=$?; rm -f /tmp/build-ca.pem; exit $status
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .
RUN mkdir -p /app/data /app/runtime && chown -R imperial:imperial /app
USER imperial

FROM base AS runtime
EXPOSE 8000
CMD ["uvicorn", "app.authority_reader.standalone:app", "--host", "0.0.0.0", "--port", "8000"]

FROM base AS test
USER root
COPY requirements.txt .
COPY requirements-dev.txt .
RUN --mount=type=secret,id=build_ca,required=false \
    if grep -q "BEGIN CERTIFICATE" /run/secrets/build_ca 2>/dev/null; then \
      cat /etc/ssl/certs/ca-certificates.crt /run/secrets/build_ca > /tmp/build-ca.pem; \
      export PIP_CERT=/tmp/build-ca.pem; \
    fi; \
    PIP_TRUSTED_HOST="${PIP_TRUSTED_HOST}" pip install --no-cache-dir \
      -r requirements.txt -r requirements-dev.txt; \
    status=$?; rm -f /tmp/build-ca.pem; exit $status
COPY tests ./tests
COPY pyproject.toml .
RUN chown -R imperial:imperial /app
USER imperial
CMD ["pytest", "-q", "tests/test_authority_reader.py", "tests/test_safe_http_pinning.py"]
