ENVIRONMENT=development
DATABASE_HOST=platform-postgres
DATABASE_PORT=5432
DATABASE_NAME=imperial_platform
DATABASE_USER=imperial_platform
DATABASE_PASSWORD_FILE=/run/secrets/platform_db_password
SESSION_SECRET=replace-with-at-least-32-random-characters
CONTROL_CENTER_API_TOKEN=
INTERNAL_JOB_TOKEN=
CONTENT_EXTERNAL_PUBLISHING_ENABLED=false
CONTENT_CAMPAIGN_PACKAGE_SECRET_FILE=/run/secrets/platform_campaign_package_secret
IMPERIAL_RELEASE_HMAC_KEY_FILE=/run/secrets/platform_release_hmac_key
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
