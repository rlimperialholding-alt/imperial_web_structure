[Unit]
Description=Everyday Homes isolated test preview
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=imperialadmin
WorkingDirectory=/opt/imperial-intelligence/worktrees/everyday-homes-web-20260808
ExecStart=/usr/bin/python3 -m http.server 18084 --bind 127.0.0.1 --directory /opt/imperial-intelligence/worktrees/everyday-homes-web-20260808
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
