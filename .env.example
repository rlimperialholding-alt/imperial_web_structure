COMPOSE_PROJECT_NAME=imperial-staging
HTTP_PORT=8080
NGINX_IMAGE=nginx:stable-alpine
PLATFORM_CORE_PORT=8091
PLATFORM_DATABASE_NAME=imperial_platform
PLATFORM_DATABASE_USER=imperial_platform
# Create this file locally with a random value. Never commit it.
PLATFORM_DB_PASSWORD_FILE=./secrets/platform_db_password.txt
# Independent copy-review service HMAC key; generate a separate random value.
PLATFORM_EXPERT_REVIEW_SECRET_FILE=./secrets/platform_expert_review_secret.txt
PLATFORM_EXPERT_REVIEW_KEY_ID=content-expert-review-v1
# Mandatory gates use separate keys so one reviewer cannot forge another gate.
PLATFORM_MARKETING_REVIEW_SECRET_FILE=./secrets/platform_marketing_review_secret.txt
PLATFORM_MARKETING_REVIEW_KEY_ID=content-marketing-review-v1
PLATFORM_COPYWRITER_REVIEW_SECRET_FILE=./secrets/platform_copywriter_review_secret.txt
PLATFORM_COPYWRITER_REVIEW_KEY_ID=content-copywriter-review-v1
PLATFORM_VISUAL_REVIEW_SECRET_FILE=./secrets/platform_visual_review_secret.txt
PLATFORM_VISUAL_REVIEW_KEY_ID=content-visual-review-v1
PLATFORM_POSTGRES_IMAGE=postgres:17-alpine
# Local sandbox value only. Never reuse in production.
PLATFORM_SESSION_SECRET=local-demo-session-key-not-for-production
PLATFORM_ENVIRONMENT=development
# Synthetic module runtime is for local development and UAT only. Production
# rejects true and defaults to disabled when this setting is omitted.
PLATFORM_DEMO_FEATURES_ENABLED=true
PLATFORM_CONTROL_CENTER_API_TOKEN=
PLATFORM_INTERNAL_JOB_TOKEN=
PLATFORM_CONTENT_EXTERNAL_PUBLISHING_ENABLED=false
PLATFORM_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,gateway,platform-core
PLATFORM_REQUIRE_HTTPS=false

# Local/UAT CRM fixtures only. Keep false or omit in production.
CRM_DEMO_SEED_ENABLED=true

# Per-project document storage is capped by default at 5 GiB. Larger customers
# should receive a dedicated, separately billed 80-200 GiB file server.
CRM_PROJECT_DOCUMENT_QUOTA_BYTES=5368709120
PARTNER_EVIDENCE_PROJECT_QUOTA_BYTES=5368709120

# AI calls stay disabled until a provider secret, approved model routing and a
# non-zero monthly budget are configured. OpenRouter allows task-specific models.
AI_EXTERNAL_CALLS_ENABLED=false
AI_ROUTING_PROVIDER=openrouter
AI_ROUTINE_MODEL=qwen/qwen3-30b-a3b-instruct-2507
AI_REASONING_MODEL=openai/gpt-5-mini
AI_MONTHLY_BUDGET_USD=0
AI_PROVIDER_API_KEY_FILE=

# Comma-separated absolute mount paths for two independent replicas. Together
# with the primary server copy this implements the required three-location policy.
IMPERIAL_BACKUP_REPLICA_DIRS=
# Leave empty on normal networks. Only set for an explicitly trusted local
# TLS-inspection environment.
PIP_TRUSTED_HOST=
# Keep true on normal networks. Use false only in an explicitly trusted,
# TLS-inspected local development environment.
NPM_STRICT_SSL=true
# Leave empty on normal networks. The value 0 is only for an explicitly
# trusted TLS-inspected local Docker build and must never be used in runtime.
NODE_TLS_REJECT_UNAUTHORIZED=
# Optional PEM certificate used only during Docker builds when an approved
# local TLS inspection product signs outbound package-registry traffic.
BUILD_CA_CERT_FILE=

# ITEP internal identity. Generate independent random values of at least
# 32 characters. Never reuse or commit production secrets.
AUTH_TOKEN_PEPPER=
AUTH_DATA_ENCRYPTION_KEY=
AUTH_BOOTSTRAP_TOKEN=
AUTH_SESSION_TTL_HOURS=12
AUTH_CHALLENGE_TTL_MINUTES=5
AUTH_INVITATION_TTL_HOURS=48
AUTH_COOKIE_SECURE=true
# Internal API address used by the CRM server-side auth proxy.
ITEP_BASE_URL=http://127.0.0.1:3000

# WhatsApp Business Platform. Use a dedicated company customer-service
# number, not an employee's personal number. Store the access token in the
# environment/vault entry derived from WHATSAPP_CONNECTOR_ID.
WHATSAPP_CONNECTOR_ID=whatsapp-live
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DATA_ENCRYPTION_KEY=
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v25.0
CONNECTOR_ACCESS_TOKEN_WHATSAPP_LIVE=

# Optional Digital Project Managers profile. Create the referenced files locally;
# never commit their contents.
DIGITAL_PM_PORT=8090
DPM_APP_ENV=development
DPM_DATABASE_NAME=imperial_dpm
DPM_DATABASE_USER=imperial_dpm
DPM_DB_PASSWORD_FILE=./secrets/dpm_db_password.txt
DPM_AUTH_HS256_SECRET_FILE=./secrets/dpm_auth_hs256_secret.txt
DPM_AUTH_ISSUER=imperial-intelligence
PLATFORM_CAMPAIGN_PACKAGE_SECRET_FILE=./secrets/platform_campaign_package_secret.txt
PLATFORM_RELEASE_HMAC_KEY_FILE=./secrets/platform_release_hmac_key.txt
DPM_AUTH_AUDIENCE=digital-project-managers
DPM_AUTH_JWKS_URL=
DPM_POSTGRES_IMAGE=postgres:17-alpine
DPM_REDIS_IMAGE=redis:8-alpine
DPM_RUNTIME_IMAGE=imperial-digital-project-managers:local
