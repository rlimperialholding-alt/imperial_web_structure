COMPOSE_PROJECT_NAME=imperial-staging
HTTP_PORT=8080
NGINX_IMAGE=nginx:stable-alpine
PLATFORM_CORE_PORT=8091
PLATFORM_DATABASE_NAME=imperial_platform
PLATFORM_DATABASE_USER=imperial_platform
# Create this file locally with a random value. Never commit it.
PLATFORM_DB_PASSWORD_FILE=./secrets/platform_db_password.txt
# Independent copy-review service HMAC key; generate a separate random value.
PLATFORM_EXPERT_REVIEW_SECRET_FILE=./secrets/platform_expert_review_secret.txt
PLATFORM_EXPERT_REVIEW_KEY_ID=content-expert-review-v1
# Mandatory gates use separate keys so one reviewer cannot forge another gate.
PLATFORM_MARKETING_REVIEW_SECRET_FILE=./secrets/platform_marketing_review_secret.txt
PLATFORM_MARKETING_REVIEW_KEY_ID=content-marketing-review-v1
PLATFORM_COPYWRITER_REVIEW_SECRET_FILE=./secrets/platform_copywriter_review_secret.txt
PLATFORM_COPYWRITER_REVIEW_KEY_ID=content-copywriter-review-v1
PLATFORM_VISUAL_REVIEW_SECRET_FILE=./secrets/platform_visual_review_secret.txt
PLATFORM_VISUAL_REVIEW_KEY_ID=content-visual-review-v1
PLATFORM_POSTGRES_IMAGE=postgres:17-alpine
# Local sandbox value only. Never reuse in production.
PLATFORM_SESSION_SECRET=local-demo-session-key-not-for-production
# Leave empty on normal networks. Only set for an explicitly trusted local
# TLS-inspection environment.
PIP_TRUSTED_HOST=

# Optional Digital Project Managers profile. Create the referenced files locally;
# never commit their contents.
DIGITAL_PM_PORT=8090
DPM_APP_ENV=development
DPM_DATABASE_NAME=imperial_dpm
DPM_DATABASE_USER=imperial_dpm
DPM_DB_PASSWORD_FILE=./secrets/dpm_db_password.txt
DPM_AUTH_HS256_SECRET_FILE=./secrets/dpm_auth_hs256_secret.txt
DPM_AUTH_ISSUER=imperial-intelligence
DPM_AUTH_AUDIENCE=digital-project-managers
DPM_AUTH_JWKS_URL=
DPM_POSTGRES_IMAGE=postgres:17-alpine
DPM_REDIS_IMAGE=redis:8-alpine
